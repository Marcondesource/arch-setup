#Terminal
super + t
    alacritty

#Firefox
super + f
    firefox --private-window

#Thunar
super + p
    thunar

#Fechar Janelas
super + x 
    xdotool getwindowfocus windowclose

#Volume 
super + F11
     pactl set-sink-volume @DEFAULT_SINK@ -5%
super + F12  
     pactl set-sink-volume @DEFAULT_SINK@ +5%
super + m  
     pactl set-sink-mute @DEFAULT_SINK@ toggle

#Screenshot
Print
     flameshot gui
super + Print
     mkdir -p ~/Imagens/Capturas && flameshot full -p ~/Imagens/Capturas

#Reiniciar
super + shift + r
    openbox --restart

#Whisker
super + a 
xfce4-popup-whiskermenu
